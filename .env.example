# Canonical site origin used for the sitemap, robots.txt, canonical URLs, and Open Graph.
# Cloudflare Pages: set this in the project environment variables.
# Must be an absolute URL with protocol and no trailing path.
SITE_URL=https://biohack-wiki.pages.dev

# Construction default: keep the site out of search indexes.
# Set to true only when the owner wants indexing. Then robots.txt allows crawling,
# the sitewide X-Robots-Tag is omitted, and the global noindex meta tag is not added.
# Stub pages can still set their own noindex.
ALLOW_INDEXING=false
