---
import { localeId, pick } from '../lib/locale';

type Source = { url: string; title: string; accessed: string; type?: string };

interface PageData {
	title?: string;
	entityType?: string;
	domain?: string;
	domains?: string[];
	evidenceLevel?: string;
	layer?: string;
	purpose?: string;
	maturity?: string;
	regulatoryStatus?: string;
	riskNotes?: string;
	lastReviewed?: string;
	status?: string;
	sources?: Source[];
}

const route = Astro.locals.starlightRoute;
const data = route?.entry?.data as PageData | undefined;
const lang = (route?.lang ?? 'en').toLowerCase();
const id = localeId(route?.lang);
const isZh = id === 'zh';

const evidence: Record<string, string> = isZh
	? {
			A: 'A · 人体随机对照',
			B: 'B · 人体观察性',
			C: 'C · 动物',
			D: 'D · 体外',
			E: 'E · 轶事',
			unrated: '未评级',
		}
	: {
			A: 'A · human randomized trial',
			B: 'B · human observational',
			C: 'C · animal',
			D: 'D · in vitro',
			E: 'E · anecdote',
			unrated: 'Not rated',
		};

const domainLabels: Record<string, string> = isZh
	? {
			biochemical: '生物化学',
			neurohacking: '神经增强',
			bionic: '仿生',
			cyborg: '赛博格',
			genetic: '基因',
			longevity: '长寿',
			'quantified-self': '自我量化',
			microbiome: '微生物组',
			lifestyle: '环境与行为',
			'cross-cutting': '跨领域',
		}
	: {};

const statusLabels: Record<string, string> = isZh
	? { reviewed: '已审阅', stub: '存根', draft: '草稿' }
	: {};

const entityLabels: Record<string, string> = isZh
	? {
			compound: '化合物',
			device: '器械',
			company: '公司',
			trial: '临床试验',
			study: '研究',
			vendor: '厂商',
			regulation: '法规',
			glossary: '术语',
			guide: '指南',
			topic: '主题',
			comparison: '对比',
			navigation: '导航',
			policy: '政策',
		}
	: {
			compound: 'Compound',
			device: 'Device',
			company: 'Company',
			trial: 'Trial',
			study: 'Study',
			vendor: 'Vendor',
			regulation: 'Regulation',
			glossary: 'Glossary',
			guide: 'Guide',
			topic: 'Topic',
			comparison: 'Comparison',
			navigation: 'Navigation',
			policy: 'Policy',
		};

const rawPages = import.meta.glob('../content/docs/**/*.{md,mdx}', {
	eager: true,
	query: '?raw',
	import: 'default',
}) as Record<string, string>;

function idFromPath(filePath: string): string {
	const normalized = filePath.replaceAll('\\', '/');
	const marker = '/content/docs/';
	const idx = normalized.lastIndexOf(marker);
	let rel = idx >= 0 ? normalized.slice(idx + marker.length) : normalized;
	rel = rel.replace(/\.(md|mdx)$/, '');
	if (rel.endsWith('/index')) rel = rel.slice(0, -'/index'.length);
	if (rel === 'index') rel = '';
	return rel;
}

function titleFrom(raw: string): string {
	const fm = raw.match(/^---\r?\n([\s\S]*?)\r?\n---/)?.[1] ?? '';
	const title = fm.match(/^title:\s*(.+)$/m)?.[1]?.trim() ?? 'Untitled';
	return title.replace(/^['"]|['"]$/g, '');
}

const currentId = (route?.id ?? '').replace(/\/$/, '');
const currentTargets = new Set<string>();
if (currentId) {
	currentTargets.add(`/${currentId}`);
	currentTargets.add(`/${currentId}/`);
} else {
	currentTargets.add('/');
	currentTargets.add('');
}

const backlinks: { href: string; title: string }[] = [];
if (data?.entityType) {
	for (const [filePath, raw] of Object.entries(rawPages)) {
		const id = idFromPath(filePath);
		if (id === currentId) continue;
		const hrefs = new Set<string>();
		for (const match of raw.matchAll(/\[[^\]]*\]\(([^)\s]+)\)/g)) hrefs.add(match[1] ?? '');
		for (const match of raw.matchAll(/href="([^"]+)"/g)) hrefs.add(match[1] ?? '');
		let hit = false;
		for (const href of hrefs) {
			if (!href.startsWith('/')) continue;
			const bare = href.split('#')[0] ?? '';
			const slashed = bare.endsWith('/') ? bare : `${bare}/`;
			if (currentTargets.has(bare) || currentTargets.has(slashed)) hit = true;
		}
		if (!hit) continue;
		backlinks.push({ href: id ? `/${id}/` : '/', title: titleFrom(raw) });
	}
	backlinks.sort((a, b) => a.title.localeCompare(b.title, id === 'zh' ? 'zh' : id === 'th' ? 'th' : 'en'));
}

const sources = data?.sources ?? [];
const show = Boolean(data?.entityType);
---

{
	show && (
		<section class="bh-facts" data-pagefind-ignore>
			<h2>{pick(id, 'Page record', '页面记录')}</h2>
			<ul class="bh-meta">
				<li>
					{pick(id, 'Type', '类型')}: {pick(id, entityLabels[data?.entityType ?? ''] ?? data?.entityType ?? '', entityLabels[data?.entityType ?? ''] ?? '')}
				</li>
				{data?.domain && (
					<li>
						{pick(id, 'Domain', '领域')}: {isZh ? (domainLabels[data.domain] ?? data.domain) : pick(id, data.domain, data.domain)}
					</li>
				)}
				{data?.layer && (
					<li>
						{pick(id, 'Layer', '层次')}: {pick(id, data.layer, data.layer)}
					</li>
				)}
				{data?.purpose && (
					<li>
						{pick(id, 'Purpose', '目的')}: {pick(id, data.purpose, data.purpose)}
					</li>
				)}
				{data?.maturity && (
					<li>
						{pick(id, 'Maturity', '成熟度')}: {data.maturity}
					</li>
				)}
				<li>
					{pick(id, 'Evidence', '证据')}: {pick(id, evidence[data?.evidenceLevel ?? 'unrated'] ?? '', evidence[data?.evidenceLevel ?? 'unrated'] ?? '')}
				</li>
				{data?.status && (
					<li>
						{pick(id, 'Status', '状态')}: {isZh ? (statusLabels[data.status] ?? data.status) : pick(id, data.status, data.status)}
					</li>
				)}
				{data?.lastReviewed && (
					<li>
						{pick(id, 'Last reviewed', '最近审阅')}: {data.lastReviewed}
					</li>
				)}
			</ul>
			{data?.regulatoryStatus && (
				<p>
					<strong>{pick(id, 'Regulatory status: ', '法规状态：')}</strong>
					{data.regulatoryStatus}
				</p>
			)}
			{data?.riskNotes && (
				<p>
					<strong>{pick(id, 'Risk notes: ', '风险笔记：')}</strong>
					{data.riskNotes}
				</p>
			)}
			{data?.status === 'stub' && (
				<p>
					<strong>{pick(id, 'Stub, needs sourcing.', '存根，需要来源。')}</strong>{' '}
					{pick(
						id,
						'This page does not yet contain enough checked facts to use as a reference.',
						'本页没有足够的已核对事实，不能当作参考依据。',
					)}
				</p>
			)}
			<h2>{pick(id, 'Sources', '来源')}</h2>
			{sources.length === 0 ? (
				<p>{pick(id, 'No external sources are attached to this page.', '本页没有附上外部来源。')}</p>
			) : (
				<ul>
					{sources.map((source) => (
						<li>
							<a href={source.url}>{source.title}</a>
							{' '}
							({source.type ? `${source.type}, ` : ''}
							{pick(id, 'accessed', '查阅于')} {source.accessed})
						</li>
					))}
				</ul>
			)}
			<h2>{pick(id, 'Referenced by', '被以下页面引用')}</h2>
			{backlinks.length === 0 ? (
				<p>{pick(id, 'No other page links here yet.', '还没有其他页面链接到这里。')}</p>
			) : (
				<ul>
					{backlinks.map((link) => (
						<li>
							<a href={link.href}>{link.title}</a>
						</li>
					))}
				</ul>
			)}
			<p>
				{pick(
					id,
					'A link from another wiki page is not evidence. Facts should point at the sources above.',
					'其他维基页面的互相引用不是证据。事实应指向上面的来源。',
				)}
			</p>
		</section>
	)
}
