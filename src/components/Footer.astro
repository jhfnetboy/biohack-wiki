---
import Default from '@astrojs/starlight/components/Footer.astro';
import PageFacts from './PageFacts.astro';
import { positioning, repoUrl } from '../data/positioning';
import { localeId, localePrefix, pick } from '../lib/locale';

const id = localeId(Astro.locals.starlightRoute?.lang);
const copy = id === 'zh' ? positioning.zh : id === 'th' ? positioning.th : positioning.en;
const prefix = localePrefix(id);
---

<PageFacts />
<p class="bh-footer-note">
	<span>{copy.tagline}</span>
	<span class="bh-footer-links">
		<a href={`${prefix}/disclaimer/`}>{pick(id, 'Medical disclaimer', '医疗免责声明')}</a>
		<a href={`${prefix}/policies/license/`}>{pick(id, 'Content CC BY-SA 4.0, code MIT', '内容 CC BY-SA 4.0，代码 MIT')}</a>
		<a href={repoUrl}>GitHub</a>
	</span>
</p>
<Default><slot /></Default>

<style>
	.bh-footer-note {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem 1.1rem;
		align-items: baseline;
		margin: 1.5rem 0 0;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}

	.bh-footer-links {
		display: inline-flex;
		flex-wrap: wrap;
		gap: 0.35rem 1.1rem;
	}
</style>
