---
import { evidenceBadge, scenariosFor, type EvidenceBadge, type Scenario } from '../../data/scenarios';
import { goalLabel, type GoalId } from '../../data/domain-keywords';
import { localeId, localePrefix, pick } from '../../lib/locale';

interface Props {
	slug: string;
}

const { slug } = Astro.props;
const scenarios = scenariosFor(slug);
const id = localeId(Astro.locals.starlightRoute?.lang);
const prefix = localePrefix(id);
const t = (en: string, zh: string) => pick(id, en, zh);
const text = (row: Scenario['name']) => row[id];
const href = (path: string) => `${prefix}${path}`;
---

{
	scenarios.length > 0 && (
		<section class="bh-scenarios">
			<h2>{t('Typical scenarios', '典型场景')}</h2>
			<p class="bh-note">
				{t(
					'Real situations this wiki can point to. A stub means the evidence has not been summarized here. No doses and no purchasing.',
					'本维基收录的真实应用情境。存根表示证据还没有在这里整理。没有剂量，也没有购买信息。',
				)}
			</p>
			<ul class="bh-grid">
				{scenarios.map((scenario) => (
					<li class:list={['bh-card', 'bh-scenario', { stub: scenario.stub }]}>
						<p class="bh-scenario-meta">
							<span class:list={['bh-evidence', scenario.badge]}>{evidenceBadge[scenario.badge][id]}</span>
							{scenario.goals.map((goal: GoalId) => (
								<span class:list={['bh-goal', goal]}>{goalLabel(goal, id)}</span>
							))}
						</p>
						<h3>{text(scenario.name)}</h3>
						<p>{text(scenario.summary)}</p>
						{scenario.sources && scenario.sources.length > 0 && (
							<ul class="bh-sources">
								{scenario.sources.map((source) => (
									<li>
										<a href={source.url} rel="noopener noreferrer">{source.label}</a>
									</li>
								))}
							</ul>
						)}
						{scenario.href && <a href={href(scenario.href)}>{t('Wiki page', '维基页面')}</a>}
					</li>
				))}
			</ul>
		</section>
	)
}
