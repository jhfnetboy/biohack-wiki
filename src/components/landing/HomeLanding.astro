---
import BodyMap from './BodyMap.astro';
import GoalBoard from './GoalBoard.astro';
import { localeId, localePrefix, pick } from '../../lib/locale';

const id = localeId(Astro.locals.starlightRoute?.lang);
const prefix = localePrefix(id);
const href = (path: string) => `${prefix}${path}`;
const t = (en: string, zh: string) => pick(id, en, zh);
---

<article class="bh-home">
	<BodyMap />
	<GoalBoard />
	<footer class="bh-quiet-foot">
		<a href={href('/about/')}>{t('About', '关于')}</a>
		<a href={href('/contributing/')}>{t('Contributing', '贡献')}</a>
		<a href="https://veriseas.pages.dev" rel="noopener">VeriSeas</a>
	</footer>
</article>
