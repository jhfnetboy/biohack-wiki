---
import Illustration from './Illustration.astro';
import KeywordBanner from './KeywordBanner.astro';
import MoleculeCompare from './MoleculeCompare.astro';
import ScenarioCards from './ScenarioCards.astro';
import { domainBySlug, type Card } from '../../data/domains';
import { goalLabel } from '../../data/domain-keywords';
import { domainScenes } from '../../data/illustrations';
import { localeId, localePrefix, pick } from '../../lib/locale';
import { toneLabel } from '../../lib/tone-label';

interface Props {
	slug: string;
}

const { slug } = Astro.props;
const domain = domainBySlug(slug);
const id = localeId(Astro.locals.starlightRoute?.lang);
const prefix = localePrefix(id);
const t = (en: string, zh: string) => pick(id, en, zh);
const href = (path: string) => `${prefix}${path}`;
const layerWord = {
	Observe: { en: 'Observe', zh: '观测', th: 'สังเกต' },
	Intervene: { en: 'Intervene', zh: '干预', th: 'แทรกแซง' },
	Augment: { en: 'Augment', zh: '增强', th: 'เสริม' },
} as const;

function cardTitle(card: Card) {
	return t(card.title, card.titleZh);
}
function cardText(card: Card) {
	return t(card.text, card.textZh);
}
---

<article class="bh-domain">
	<header class="bh-hero">
		<Illustration name={domain.slot} wide />
		<KeywordBanner domain={domain.slug} />
		<h1>{t(domain.title, domain.titleZh)}</h1>
		<p class="bh-lead">{t(domain.definition, domain.definitionZh)}</p>
		<ul class="bh-badges">
			{
				domain.layers.map((layer) => (
					<li>
						{id === 'en' ? 'Layer' : id === 'zh' ? '层次' : 'ชั้น'} · {layerWord[layer][id]}
					</li>
				))
			}
		</ul>
		<ul class="bh-goal-row">
			{
				domain.goals.map((goal) => (
					<li class:list={['bh-goal', goal]}>{goalLabel(goal, id)}</li>
				))
			}
		</ul>
	</header>

	{slug === 'cyborg' && (
		<aside class="bh-callout">
			<p>
				{t(
					'Brain implants such as Neuralink are filed under Neurotech, because anything that reads or writes neural signals belongs there. Cyborg implants do not interface with the nervous system.',
					'Neuralink 这类脑植入归在神经科技，因为任何读写神经信号的东西都属于那里。赛博格植入物不与神经系统接口。',
				)}
			</p>
			<p>
				<a href={href('/neurohacking/bci/neuralink-n1/')}>{t('Open the N1 page', '打开 N1 页面')}</a>
			</p>
		</aside>
	)}

	<ScenarioCards slug={slug} />
	{slug === 'biochemical' && <MoleculeCompare />}

	<section>
		<h2>{t('Map of the domain', '领域地图')}</h2>
		<p class="bh-note">
			{
				t(
					'Cards cover the field as this wiki files it. A stub card is not a finding.',
					'卡片按本维基的归档覆盖该领域。存根卡片不是结论。',
				)
			}
		</p>
		<ul class="bh-grid">
			{
				domain.areas.map((area) => (
					<li class:list={['bh-card', { stub: area.stub }]}>
						{area.stub && <span class="bh-pill stub">{t('Stub', '存根')}</span>}
						<h3>{cardTitle(area)}</h3>
						<p>{cardText(area)}</p>
						{area.href && <a href={href(area.href)}>{t('Open', '打开')}</a>}
					</li>
				))
			}
		</ul>
	</section>

	<section>
		<h2>{t('Representative examples', '代表性例子')}</h2>
		<ul class="bh-grid">
			{
				domain.examples.map((example) => (
					<li class:list={['bh-card', { stub: example.stub }]}>
						<div class="bh-badge-row">
							{example.maturity && <span class="bh-pill">{example.maturity}</span>}
							{example.evidence && <span class="bh-pill">{t('Evidence', '证据')} {example.evidence}</span>}
							{example.stub && <span class="bh-pill stub">{t('Stub', '存根')}</span>}
						</div>
						<h3>{cardTitle(example)}</h3>
						<p>{cardText(example)}</p>
						{example.href && <a href={href(example.href)}>{t('Open', '打开')}</a>}
					</li>
				))
			}
		</ul>
	</section>

	<section>
		<h2>{t('Maturity snapshot', '成熟度快照')}</h2>
		<table class="bh-table">
			<thead>
				<tr>
					<th>{t('Row', '行')}</th>
					<th>{t('Status', '状态')}</th>
				</tr>
			</thead>
			<tbody>
				{
					domain.maturityRows.map((row) => (
						<tr>
							<td>{t(row.label, row.labelZh)}</td>
							<td>
								<span class:list={['bh-pill', row.tone]}>{toneLabel(row.tone, id)}</span>
								{t(row.note, row.noteZh)}
							</td>
						</tr>
					))
				}
			</tbody>
		</table>
	</section>

	<section>
		<h2>{t('Debates and risks', '争论与风险')}</h2>
		<ul class="bh-stack">
			{
				domain.debates.map((item) => (
					<li>
						<strong>{cardTitle(item)}</strong>
						{item.stub && <span class="bh-pill stub">{t('Stub', '存根')}</span>}
						<p>{cardText(item)}</p>
						{item.href && <a href={href(item.href)}>{t('Open', '打开')}</a>}
					</li>
				))
			}
		</ul>
	</section>

	<section>
		<h2>{t('Regulation snapshot', '监管快照')}</h2>
		<ul class="bh-stack">
			{
				domain.regulation.map((item) => (
					<li>
						<strong>{cardTitle(item)}</strong>
						{item.stub && <span class="bh-pill stub">{t('Stub', '存根')}</span>}
						<p>{cardText(item)}</p>
						{item.href && <a href={href(item.href)}>{t('Open', '打开')}</a>}
					</li>
				))
			}
		</ul>
	</section>

	<section>
		<h2>{t('Related domains', '相关领域')}</h2>
		<ul class="bh-links">
			{
				domain.related.map((item) => (
					<li>
						<a href={href(item.href)}>{t(item.title, item.titleZh)}</a>
					</li>
				))
			}
		</ul>
	</section>

	<section>
		<h2>{t('Start here', '从这里开始')}</h2>
		<ol class="bh-links">
			{
				domain.startHere.map((item) => (
					<li>
						<a href={href(item.href)}>{t(item.title, item.titleZh)}</a>
					</li>
				))
			}
		</ol>
	</section>

	{
		(domainScenes[domain.slug] ?? []).length > 0 && (
			<section>
				<h2>{t('Scenes', '场景')}</h2>
				<div class="bh-scenes">
					{(domainScenes[domain.slug] ?? []).map((name) => (
						<Illustration name={name} wide />
					))}
				</div>
			</section>
		)
	}

	<section class="bh-updates">
		<h2>{t('Latest updates', '最新动态')}</h2>
		<p>
			{
				t(
					'No items yet. Reviewed daily notes will appear here later. Nothing is auto-published.',
					'还没有条目。审阅后的每日笔记以后会出现在这里。不会自动发布。',
				)
			}
		</p>
	</section>
</article>
