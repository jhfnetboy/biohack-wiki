---
import Default from '@astrojs/starlight/components/Banner.astro';
import { localeId, localePrefix, pick } from '../lib/locale';

const id = localeId(Astro.locals.starlightRoute?.lang);
const href = `${localePrefix(id)}/disclaimer/`;
---

<div class="bh-banner" data-pagefind-ignore>
	<p>
		{pick(
			id,
			'Educational reference only. Not medical advice, diagnosis, or treatment, and not dosing, injection, or purchasing guidance.',
			'本站仅供教育参考，不是医疗建议、诊断或治疗建议，也不提供剂量、注射或购买指引。',
		)}{' '}
		<a href={href}>{pick(id, 'Medical disclaimer', '医疗免责声明')}</a>
	</p>
</div>
<Default />
